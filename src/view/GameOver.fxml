<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane prefHeight="0.0" prefWidth="0.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameOverController">
   <children>
      <ImageView fx:id="backgroundImageView" pickOnBounds="true" StackPane.alignment="CENTER">
         <image>
            <Image url="@../resources/images/gameoverbg.png" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="40.0" style="-fx-border-color: #e94560; -fx-border-width: 10;" StackPane.alignment="CENTER">
         <children>
            <Label text="GAME OVER" textFill="#e94560">
               <font>
                  <Font name="System Bold" size="72.0" />
               </font>
            </Label>
            
            <Label text="Laziness caught up to you..." textFill="#ecf0f1">
               <font>
                  <Font name="System Italic" size="18.0" />
               </font>
            </Label>
      
            <Label fx:id="finalScoreLabel" text="FINAL SCORE: 0" textFill="#f1c40f">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font>
            </Label>
      
            <Button alignment="CENTER" onAction="#handleReturnToMenu" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="RETURN TO MENU">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
